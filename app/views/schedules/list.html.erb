<%= link_to ">カレンダーに戻る", root_path, class: "back-calendar" %>
<h1 class="schedule-list">予定一覧</h1>

<p class = "date-list"><%= @date %></p>

<% @schedules.each do |schedule| %>
  <div>
    <p class="list-title">
      <span class = "schedule-label">タイトル</span>
      <span><%= schedule.title %></span>
    </p>
    <p class="list-time">
      <span class = "schedule-label">開始時間～終了時間</span>
      <span>
        <%= schedule.start_time.strftime("%H:%M") %>
        ～ 
        <%= schedule.end_time.strftime("%H:%M") %>
      </span>
    </p>

    <p class = "detail-schedule">
      <%= link_to "詳細を見る", schedule_path(schedule), class: "look-detail-schedule" %>
    </p>
  </div>
<% end %>