<%= link_to ">一覧に戻る", schedule_list_path(date: @schedule.date), class: "back-list" %>
<%= link_to "編集", edit_schedule_path, class: "edit-schedule" %>
<%= link_to "削除", schedule_path(@schedule), data: {turbo_method: :delete}, class: "delete-schedule" %>
<h1 class="show-detail">詳細</h1>

<div>
    <p class="show-date">
      <span><%= @schedule.date%></span>
    </p>

    <p class="show-title">
      <span class = "schedule-label">タイトル</span>
      <span><%= @schedule.title %></span>
    </p>
    <p class="show-time">
      <span class = "schedule-label">開始時間～終了時間</span>
      <span>
        <%= @schedule.start_time.strftime("%H:%M") %>
        ～ 
        <%= @schedule.end_time.strftime("%H:%M") %>
      </span>
    </p>

    <p class = "detail-schedule">
      <span><%= @schedule.detail %></span>
    </p>
  </div>