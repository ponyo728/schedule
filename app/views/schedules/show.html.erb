<%= link_to "一覧に戻る", schedule_list_path(date: @schedule.date) %>
<%= link_to "編集", edit_schedule_path %>
<%= link_to "削除", schedule_path(@schedule), data: {turbo_method: :delete} %>
<h1>詳細</h1>

<div>
    <p>
      <span><%= @schedule.date%></span>
    </p>

    <p>
      <span class = "schedule-label">タイトル</span>
      <span><%= @schedule.title %></span>
    </p>
    <p>
      <span class = "schedule-label">開始時間～終了時間</span>
      <span>
        <%= @schedule.start_time.strftime("%H:%M") %>
        ～ 
        <%= @schedule.end_time.strftime("%H:%M") %>
      </span>
    </p>

    <p class = "detail-schedule">
      <span><%= @schedule.detail %></span>
    </p>
  </div>